# Paper desk reads the GMGN key and, optionally, Solana listener endpoints.
# It does not read wallet or signing keys. The placeholders below are unused
# future-only fields. Do not put a live key in this file for the paper desk.
# `paper_desk live` refuses even when those values are set.
#
# Copy to .env. Never commit .env.

# Required for real-market paper mode. Apply at https://gmgn.ai/ai
# Sent only as the X-APIKEY header on documented read-only routes.
GMGN_API_KEY=

# free, plus, or pro. Selects the documented leaky bucket (5/5, 20/20, 50/50).
GMGN_PLAN=free

# Optional override. gmgn-cli 1.7.1 hardcodes this host.
# GMGN_API_HOST=https://openapi.gmgn.ai

# Optional. Enables the upstream logs listener (pump.fun) and blocks listener
# (letsbonk.fun). The URL often contains an API key; it is redacted in logs.
SOLANA_NODE_WSS_ENDPOINT=

# Unused by the paper desk. Kept so the upstream live bot's docs still match.
SOLANA_NODE_RPC_ENDPOINT=

# Optional. Enables the upstream geyser listener for pump.fun and letsbonk.
# Shreds are refused (pre-execution). Auth type is x-token or basic.
GEYSER_ENDPOINT=
GEYSER_API_TOKEN=
GEYSER_AUTH_TYPE=x-token

# UNUSED by the paper desk. Not required. Ignored if set.
SOLANA_PRIVATE_KEY=
GMGN_PRIVATE_KEY=
KEYSTORE_PASSWORD=
